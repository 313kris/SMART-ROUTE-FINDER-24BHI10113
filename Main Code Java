import javax.swing.*;
import javax.swing.border.EmptyBorder;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.geom.Ellipse2D;
import java.net.URI;
import java.util.List;
import java.util.*;

/**
 * Master GPS - Java version of the Python/Gradio project.
 *
 * Features:
 * - Source & destination input
 * - 3 random routes
 * - Risk scoring
 * - Weather simulation
 * - Route summary table
 * - Graph of route risks
 * - Open Google Maps in browser
 * - Optional best-effort text-to-speech via OS commands
 *
 * Save as: MasterGPS.java
 * Compile: javac MasterGPS.java
 * Run:     java MasterGPS
 */
public class MasterGPS extends JFrame {

    private final JTextField sourceField = new JTextField();
    private final JTextField destinationField = new JTextField();
    private final JComboBox<String> preferenceBox = new JComboBox<>(new String[]{"Safe", "Fast", "Balanced"});
    private final JTextArea outputArea = new JTextArea(22, 30);
    private final JTable routeTable;
    private final DefaultTableModel tableModel;
    private final GraphPanel graphPanel = new GraphPanel();

    private List<RouteInfo> currentRoutes = new ArrayList<>();
    private WeatherInfo currentSourceWeather;
    private WeatherInfo currentDestinationWeather;

    public MasterGPS() {
        super("🚦 Master GPS - Java");
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setSize(1250, 820);
        setLocationRelativeTo(null);

        // Top inputs panel
        JPanel inputPanel = new JPanel(new GridBagLayout());
        inputPanel.setBorder(new EmptyBorder(14, 14, 14, 14));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(6, 6, 6, 6);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        gbc.gridx = 0; gbc.gridy = 0;
        inputPanel.add(new JLabel("Enter Source:"), gbc);
        gbc.gridx = 1; gbc.gridy = 0; gbc.weightx = 1.0;
        inputPanel.add(sourceField, gbc);

        gbc.gridx = 0; gbc.gridy = 1; gbc.weightx = 0;
        inputPanel.add(new JLabel("Enter Destination:"), gbc);
        gbc.gridx = 1; gbc.gridy = 1; gbc.weightx = 1.0;
        inputPanel.add(destinationField, gbc);

        gbc.gridx = 0; gbc.gridy = 2; gbc.weightx = 0;
        inputPanel.add(new JLabel("Preference:"), gbc);
        gbc.gridx = 1; gbc.gridy = 2; gbc.weightx = 1.0;
        inputPanel.add(preferenceBox, gbc);

        JButton predictButton = new JButton("Predict Route");
        JButton openSourceMapButton = new JButton("Open Source Map");
        JButton openDestinationMapButton = new JButton("Open Destination Map");
        JButton speakButton = new JButton("Speak Output");
        JButton clearButton = new JButton("Clear");

        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 0));
        buttonPanel.add(predictButton);
        buttonPanel.add(openSourceMapButton);
        buttonPanel.add(openDestinationMapButton);
        buttonPanel.add(speakButton);
        buttonPanel.add(clearButton);

        gbc.gridx = 0; gbc.gridy = 3; gbc.gridwidth = 2;
        inputPanel.add(buttonPanel, gbc);

        // Output area
        outputArea.setEditable(false);
        outputArea.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 13));
        JScrollPane outputScroll = new JScrollPane(outputArea);
        outputScroll.setBorder(BorderFactory.createTitledBorder("AI Navigation Output"));

        // Route table
        String[] columns = {"Route", "Path", "Risk", "Traffic", "Weather", "Accidents", "Condition", "Temp (°C)", "Humidity (%)", "Wind (km/h)"};
        tableModel = new DefaultTableModel(columns, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };
        routeTable = new JTable(tableModel);
        routeTable.setRowHeight(24);
        JScrollPane tableScroll = new JScrollPane(routeTable);
        tableScroll.setBorder(BorderFactory.createTitledBorder("Route Details"));

        // Left side panels
        JSplitPane leftSplit = new JSplitPane(JSplitPane.VERTICAL_SPLIT, outputScroll, tableScroll);
        leftSplit.setResizeWeight(0.62);
        leftSplit.setDividerLocation(420);

        // Right side graph panel
        JPanel rightPanel = new JPanel(new BorderLayout());
        rightPanel.setBorder(new EmptyBorder(8, 8, 8, 8));
        graphPanel.setPreferredSize(new Dimension(420, 560));
        rightPanel.add(graphPanel, BorderLayout.CENTER);

        JSplitPane centerSplit = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, leftSplit, rightPanel);
        centerSplit.setResizeWeight(0.70);
        centerSplit.setDividerLocation(760);

        JLabel title = new JLabel("Navigation That Protects Lives.", SwingConstants.CENTER);
        title.setFont(new Font("SansSerif", Font.BOLD, 18));
        title.setBorder(new EmptyBorder(10, 10, 10, 10));

        JPanel root = new JPanel(new BorderLayout());
        root.add(title, BorderLayout.NORTH);
        root.add(inputPanel, BorderLayout.WEST);
        root.add(centerSplit, BorderLayout.CENTER);
        setContentPane(root);

        // Actions
        predictButton.addActionListener(this::handlePredict);
        openSourceMapButton.addActionListener(e -> openMaps(sourceField.getText().trim()));
        openDestinationMapButton.addActionListener(e -> openMaps(destinationField.getText().trim()));
        speakButton.addActionListener(e -> speakText(outputArea.getText()));
        clearButton.addActionListener(e -> clearForm());
    }

    private void handlePredict(ActionEvent e) {
        String source = sourceField.getText().trim();
        String destination = destinationField.getText().trim();
        String preference = (String) preferenceBox.getSelectedItem();

        if (source.isEmpty() || destination.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please enter both source and destination.", "Input Required", JOptionPane.WARNING_MESSAGE);
            return;
        }

        currentRoutes = new ArrayList<>();
        for (int i = 0; i < 3; i++) {
            Map<String, Integer> data = collectData();
            double risk = calculateRisk(data);
            WeatherInfo routeWeather = getWeather("Route " + (char) ('A' + i));

            currentRoutes.add(new RouteInfo(
                    "Route " + (char) ('A' + i),
                    getRouteName(source, destination),
                    data,
                    risk,
                    routeWeather
            ));
        }

        currentSourceWeather = getWeather(source);
        currentDestinationWeather = getWeather(destination);

        String response = generateResponse(currentRoutes, preference, currentSourceWeather, currentDestinationWeather);
        outputArea.setText(response);

        updateTable(currentRoutes);
        graphPanel.setRoutes(currentRoutes);
        graphPanel.repaint();
    }

    private void updateTable(List<RouteInfo> routes) {
        tableModel.setRowCount(0);
        for (RouteInfo r : routes) {
            tableModel.addRow(new Object[]{
                    r.name,
                    r.routePath,
                    String.format(Locale.US, "%.2f", r.risk),
                    r.data.get("traffic"),
                    r.data.get("weather"),
                    r.data.get("accidents"),
                    r.weather.condition,
                    r.weather.temperature,
                    r.weather.humidity,
                    r.weather.windSpeed
            });
        }
    }

    private void clearForm() {
        sourceField.setText("");
        destinationField.setText("");
        preferenceBox.setSelectedIndex(0);
        outputArea.setText("");
        tableModel.setRowCount(0);
        currentRoutes.clear();
        currentSourceWeather = null;
        currentDestinationWeather = null;
        graphPanel.setRoutes(Collections.emptyList());
        graphPanel.repaint();
    }

    // -------------------------------
    // DATA COLLECTION
    // -------------------------------
    private Map<String, Integer> collectData() {
        Random random = new Random();
        Map<String, Integer> data = new HashMap<>();
        data.put("traffic", random.nextInt(10) + 1);   // 1..10
        data.put("weather", random.nextInt(10) + 1);    // 1..10
        data.put("accidents", random.nextInt(91) + 10); // 10..100
        data.put("road", random.nextInt(10) + 1);       // 1..10
        return data;
    }

    // -------------------------------
    // RISK ENGINE
    // -------------------------------
    private double calculateRisk(Map<String, Integer> data) {
        return round2(
                0.4 * data.get("accidents") / 100.0 +
                0.3 * data.get("traffic") / 10.0 +
                0.2 * data.get("weather") / 10.0 +
                0.1 * data.get("road") / 10.0
        );
    }

    private double round2(double value) {
        return Math.round(value * 100.0) / 100.0;
    }

    // -------------------------------
    // ROUTE NAME GENERATOR
    // -------------------------------
    private String getRouteName(String source, String destination) {
        List<String> roads = Arrays.asList(
                source + " → NH48 → " + destination,
                source + " → Ring Road → " + destination,
                source + " → Expressway → " + destination,
                source + " → City Bypass → " + destination,
                source + " → State Highway → " + destination
        );
        return roads.get(new Random().nextInt(roads.size()));
    }

    // -------------------------------
    // WEATHER
    // -------------------------------
    private WeatherInfo getWeather(String location) {
        String[] conditions = {"Sunny", "Cloudy", "Rainy", "Stormy"};
        Random random = new Random();
        return new WeatherInfo(
                location,
                conditions[random.nextInt(conditions.length)],
                random.nextInt(21) + 18,  // 18..38
                random.nextInt(51) + 40,   // 40..90
                random.nextInt(36) + 5     // 5..40
        );
    }

    // -------------------------------
    // RESPONSE GENERATOR
    // -------------------------------
    private String generateResponse(List<RouteInfo> routes, String preference, WeatherInfo sourceWeather, WeatherInfo destinationWeather) {
        RouteInfo safest = Collections.min(routes, Comparator.comparingDouble(r -> r.risk));
        RouteInfo fastest = Collections.max(routes, Comparator.comparingInt(r -> r.data.get("traffic")));
        RouteInfo balanced = safest;

        StringBuilder response = new StringBuilder();

        for (int i = 0; i < routes.size(); i++) {
            RouteInfo r = routes.get(i);
            response.append("\n\nRoute ").append((char) ('A' + i)).append(":\n");
            response.append("  Path: ").append(r.routePath).append("\n");
            response.append("  Risk Score: ").append(String.format(Locale.US, "%.2f", r.risk)).append("\n");
            response.append("  Traffic: ").append(r.data.get("traffic")).append("\n");
            response.append("  Weather: ").append(r.data.get("weather")).append("\n");
            response.append("  Accidents: ").append(r.data.get("accidents")).append("\n");
            response.append("  Condition: ").append(r.weather.condition).append("\n");
            response.append("  Temperature: ").append(r.weather.temperature).append("°C\n");
            response.append("  Humidity: ").append(r.weather.humidity).append("%\n");
            response.append("  Wind Speed: ").append(r.weather.windSpeed).append(" km/h\n");

            if ("Stormy".equalsIgnoreCase(r.weather.condition)) {
                response.append("  🚨 DANGER ALERT: Storm ahead in ").append(r.name).append("\n");
            } else if (r.risk > 0.60) {
                response.append("  ⚠ HIGH RISK: Accident-prone route detected\n");
            }
        }

        response.append("\n\n🧠 Intelligent Analysis:\n");
        if ("Safe".equalsIgnoreCase(preference)) {
            response.append("I recommend ").append(safest.name).append(" because it is safest.\n");
        } else if ("Fast".equalsIgnoreCase(preference)) {
            response.append("I recommend ").append(fastest.name).append(" because it is fastest.\n");
        } else {
            response.append("I recommend ").append(balanced.name).append(" because it provides a balanced route.\n");
        }

        response.append("\n📍 Source Weather:\n");
        response.append(formatWeather(sourceWeather));

        response.append("\n📍 Destination Weather:\n");
        response.append(formatWeather(destinationWeather));

        response.append("\n⚠ Safety Insights:\n");
        response.append("- High traffic increases collision probability.\n");
        response.append("- Bad weather increases braking distance.\n");
        response.append("- Wind affects vehicle stability.\n");

        return response.toString();
    }

    private String formatWeather(WeatherInfo w) {
        return "Location: " + w.location + "\n" +
               "Condition: " + w.condition + "\n" +
               "Temperature: " + w.temperature + "°C\n" +
               "Humidity: " + w.humidity + "%\n" +
               "Wind Speed: " + w.windSpeed + " km/h\n";
    }

    // -------------------------------
    // MAPS
    // -------------------------------
    private void openMaps(String location) {
        if (location == null || location.trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Enter a location first.", "Missing Location", JOptionPane.WARNING_MESSAGE);
            return;
        }
        try {
            String url = "https://www.google.com/maps/search/" + URI.create(location.trim().replace(" ", "+")).toASCIIString();
            Desktop.getDesktop().browse(URI.create(url));
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Could not open maps: " + ex.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    // -------------------------------
    // TTS (best-effort, OS dependent)
    // -------------------------------
    private void speakText(String text) {
        if (text == null || text.trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Nothing to speak yet. Generate output first.", "No Text", JOptionPane.INFORMATION_MESSAGE);
            return;
        }

        String os = System.getProperty("os.name", "").toLowerCase(Locale.ROOT);
        try {
            if (os.contains("mac")) {
                new ProcessBuilder("say", text).start();
            } else if (os.contains("win")) {
                String safeText = text.replace("'", "''");
                String ps = "Add-Type -AssemblyName System.Speech; " +
                        "(New-Object System.Speech.Synthesis.SpeechSynthesizer).Speak('" + safeText + "')";
                new ProcessBuilder("powershell", "-Command", ps).start();
            } else {
                // Linux / Unix: espeak is commonly available, but not guaranteed.
                new ProcessBuilder("espeak", text).start();
            }
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this,
                    "Text-to-speech could not be started on this device.\n" +
                    "You can still read the output in the text box.\n\n" +
                    ex.getMessage(),
                    "TTS Unavailable",
                    JOptionPane.INFORMATION_MESSAGE);
        }
    }

    // -------------------------------
    // MAIN
    // -------------------------------
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            try {
                UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
            } catch (Exception ignored) {}
            new MasterGPS().setVisible(true);
        });
    }

    // -------------------------------
    // DATA CLASSES
    // -------------------------------
    private static class RouteInfo {
        String name;
        String routePath;
        Map<String, Integer> data;
        double risk;
        WeatherInfo weather;

        RouteInfo(String name, String routePath, Map<String, Integer> data, double risk, WeatherInfo weather) {
            this.name = name;
            this.routePath = routePath;
            this.data = data;
            this.risk = risk;
            this.weather = weather;
        }
    }

    private static class WeatherInfo {
        String location;
        String condition;
        int temperature;
        int humidity;
        int windSpeed;

        WeatherInfo(String location, String condition, int temperature, int humidity, int windSpeed) {
            this.location = location;
            this.condition = condition;
            this.temperature = temperature;
            this.humidity = humidity;
            this.windSpeed = windSpeed;
        }
    }

    // -------------------------------
    // GRAPH PANEL
    // -------------------------------
    private static class GraphPanel extends JPanel {
        private List<RouteInfo> routes = Collections.emptyList();

        void setRoutes(List<RouteInfo> routes) {
            this.routes = (routes == null) ? Collections.emptyList() : new ArrayList<>(routes);
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g.create();
            try {
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                int w = getWidth();
                int h = getHeight();
                int pad = 50;

                // Background
                g2.setColor(new Color(250, 250, 250));
                g2.fillRect(0, 0, w, h);

                // Title
                g2.setColor(Color.DARK_GRAY);
                g2.setFont(new Font("SansSerif", Font.BOLD, 18));
                g2.drawString("Route Risk Comparison", pad, 28);

                // Axes
                int x0 = pad;
                int y0 = h - pad;
                int x1 = w - pad;
                int y1 = pad + 20;
                g2.setColor(Color.GRAY);
                g2.drawLine(x0, y0, x1, y0);
                g2.drawLine(x0, y0, x0, y1);

                g2.setFont(new Font("SansSerif", Font.PLAIN, 12));
                g2.drawString("Risk Score", 5, y1 + 10);
                g2.drawString("Routes", w / 2 - 20, h - 10);

                // Grid labels
                for (int i = 0; i <= 5; i++) {
                    double tick = i / 5.0;
                    int yy = (int) (y0 - tick * (y0 - y1));
                    g2.setColor(new Color(220, 220, 220));
                    g2.drawLine(x0, yy, x1, yy);
                    g2.setColor(Color.GRAY);
                    g2.drawString(String.format(Locale.US, "%.1f", tick), 15, yy + 4);
                }

                if (routes == null || routes.isEmpty()) {
                    g2.setColor(Color.GRAY);
                    g2.drawString("No route data yet. Click Predict Route.", x0 + 20, y0 - 20);
                    return;
                }

                int n = routes.size();
                int plotW = x1 - x0;
                int plotH = y0 - y1;
                int step = (n == 1) ? plotW / 2 : plotW / (n - 1);

                int prevX = -1;
                int prevY = -1;

                for (int i = 0; i < n; i++) {
                    RouteInfo r = routes.get(i);
                    double risk = Math.max(0, Math.min(1, r.risk));
                    int x = (n == 1) ? (x0 + plotW / 2) : (x0 + i * step);
                    int y = (int) (y0 - risk * plotH);

                    // line
                    if (prevX != -1) {
                        g2.setStroke(new BasicStroke(2.5f));
                        g2.setColor(new Color(60, 120, 216));
                        g2.drawLine(prevX, prevY, x, y);
                    }

                    // point
                    int size = 12;
                    g2.setColor(new Color(220, 50, 50));
                    g2.fill(new Ellipse2D.Double(x - size / 2.0, y - size / 2.0, size, size));
                    g2.setColor(Color.DARK_GRAY);
                    g2.drawString(r.name, x - 18, y + 24);
                    g2.drawString(String.format(Locale.US, "%.2f", risk), x - 12, y - 10);

                    prevX = x;
                    prevY = y;
                }
            } finally {
                g2.dispose();
            }
        }
    }
}
