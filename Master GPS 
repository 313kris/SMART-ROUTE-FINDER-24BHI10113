        "import gradio as gr\n",
        "import random\n",
        "import matplotlib.pyplot as plt\n",
        "from gtts import gTTS\n",
        "import tempfile\n",
        "\n",
        "def collect_data():\n",
        "    return {\n",
        "        \"traffic\": random.randint(1, 10),\n",
        "        \"weather\": random.randint(1, 10),\n",
        "        \"accidents\": random.randint(10, 100),\n",
        "        \"road\": random.randint(1, 10)\n",
        "    }\n",
        "\n",
        "def calculate_risk(data):\n",
        "    return round(\n",
        "        0.4 * data[\"accidents\"]/100 +\n",
        "        0.3 * data[\"traffic\"]/10 +\n",
        "        0.2 * data[\"weather\"]/10 +\n",
        "        0.1 * data[\"road\"]/10,\n",
        "        2\n",
        "    )\n",
        "\n",
        "def get_route_name(source, destination):\n",
        "    roads = [\n",
        "        f\"{source} → NH48 → {destination}\",\n",
        "        f\"{source} → Ring Road → {destination}\",\n",
        "        f\"{source} → Expressway → {destination}\",\n",
        "        f\"{source} → City Bypass → {destination}\",\n",
        "        f\"{source} → State Highway → {destination}\"\n",
        "    ]\n",
        "    return random.choice(roads)\n",
        "\n",
        "def get_weather(location):\n",
        "    conditions = [\"Sunny\", \"Cloudy\", \"Rainy\", \"Stormy\"]\n",
        "    return {\n",
        "        \"location\": location,\n",
        "        \"condition\": random.choice(conditions),\n",
        "        \"temperature\": random.randint(18, 38),\n",
        "        \"humidity\": random.randint(40, 90),\n",
        "        \"wind_speed\": random.randint(5, 40)\n",
        "    }\n",
        "\n",
        "def generate_graph(routes):\n",
        "    names = [r[\"name\"] for r in routes]\n",
        "    risks = [r[\"risk\"] for r in routes]\n",
        "\n",
        "    plt.figure(figsize=(10,6))\n",
        "    plt.plot(names, risks, marker='o')\n",
        "    plt.xlabel(\"Routes\")\n",
        "    plt.ylabel(\"Risk Score\")\n",
        "    plt.title(\"Route Risk Comparison\")\n",
        "    plt.grid()\n",
        "\n",
        "    return plt\n",
        "\n",
        "def generate_llm_response(routes, preference, source_weather, destination_weather):\n",
        "\n",
        "    safest = min(routes, key=lambda x: x[\"risk\"])\n",
        "    fastest = max(routes, key=lambda x: x[\"data\"][\"traffic\"])\n",
        "\n",
        "    response = \"\"\n",
        "\n",
        "    for i, r in enumerate(routes):\n",
        "        response += f\"\\n\\nRoute {chr(65+i)}:\\n\"\n",
        "        response += f\"  Path: {r['route_path']}\\n\"   # ⭐ NEW LINE\n",
        "        response += f\"  Risk Score: {r['risk']}\\n\"\n",
        "        response += f\"  Traffic: {r['data']['traffic']}\\n\"\n",
        "        response += f\"  Weather: {r['data']['weather']}\\n\"\n",
        "        response += f\"  Accidents: {r['data']['accidents']}\\n\"\n",
        "\n",
        "        response += f\"\\n  Condition: {r['weather']['condition']}\\n\"\n",
        "        response += f\"  Temperature: {r['weather']['temperature']}°C\\n\"\n",
        "        response += f\"  Humidity: {r['weather']['humidity']}%\\n\"\n",
        "        response += f\"  Wind Speed: {r['weather']['wind_speed']} km/h\\n\"\n",
        "\n",
        "        if r['weather']['condition'] == \"Stormy\":\n",
        "            response += f\"  🚨 DANGER ALERT: Storm ahead in {r['name']}\\n\"\n",
        "        elif r['risk'] > 0.6:\n",
        "            response += f\"  ⚠ HIGH RISK: Accident-prone route detected\\n\"\n",
        "\n",
        "    response += \"\\n\\n🧠 Intelligent Analysis:\\n\"\n",
        "    if preference == \"Safe\":\n",
        "        response += f\"I recommend {safest['name']} because it is safest.\\n\"\n",
        "    elif preference == \"Fast\":\n",
        "        response += f\"I recommend {fastest['name']} because it is fastest.\\n\"\n",
        "    else:\n",
        "        response += f\"I recommend {safest['name']} because it provides a balanced route.\\n\"\n",
        "\n",
        "    response += \"\\n📍 Source Weather:\\n\"\n",
        "    response += f\"Location: {source_weather['location']}\\n\"\n",
        "    response += f\"Condition: {source_weather['condition']}\\n\"\n",
        "    response += f\"Temperature: {source_weather['temperature']}°C\\n\"\n",
        "    response += f\"Humidity: {source_weather['humidity']}%\\n\"\n",
        "    response += f\"Wind Speed: {source_weather['wind_speed']} km/h\\n\"\n",
        "\n",
        "    response += \"\\n📍 Destination Weather:\\n\"\n",
        "    response += f\"Location: {destination_weather['location']}\\n\"\n",
        "    response += f\"Condition: {destination_weather['condition']}\\n\"\n",
        "    response += f\"Temperature: {destination_weather['temperature']}°C\\n\"\n",
        "    response += f\"Humidity: {destination_weather['humidity']}%\\n\"\n",
        "    response += f\"Wind Speed: {destination_weather['wind_speed']} km/h\\n\"\n",
        "\n",
        "    response += \"\\n⚠ Safety Insights:\\n\"\n",
        "    response += \"- High traffic increases collision probability.\\n\"\n",
        "    response += \"- Bad weather increases braking distance.\\n\"\n",
        "    response += \"- Wind affects vehicle stability.\\n\"\n",
        "\n",
        "    return response\n",
        "\n",
        "def text_to_speech(text):\n",
        "    tts = gTTS(text)\n",
        "    temp_file = tempfile.NamedTemporaryFile(delete=False, suffix=\".mp3\")\n",
        "    tts.save(temp_file.name)\n",
        "    return temp_file.name\n",
        "\n",
        "def generate_map(source, destination):\n",
        "    return f\"\"\"\n",
        "    <div style=\"width:100%; font-family:sans-serif; background:#111; color:white;\">\n",
        "\n",
        "        <!-- 🔍 HEADER -->\n",
        "        <div style=\"padding:10px;\">\n",
        "            <h3>🔍 Explore Nearby</h3>\n",
        "        </div>\n",
        "\n",
        "        <!-- 🍽 FOOD & DRINK -->\n",
        "        <div style=\"padding:10px;\">\n",
        "            <b>Food & Drink</b><br><br>\n",
        "            <button onclick=\"searchPlace('restaurants')\">🍽 Restaurants</button>\n",
        "            <button onclick=\"searchPlace('takeout')\">🥡 Takeout</button>\n",
